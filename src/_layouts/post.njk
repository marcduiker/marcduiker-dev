---
layout: base
schema: blog
---

<article class="region blog" style="--region-space-top: var(--space-xl-2xl)">
  <div class="wrapper flow prose">
    <h1 class="text-theme-secondary">{{ title }}</h1>

    {% if image %}
      <!-- image -->
      {% image image, alt or title, credit, "eager", "feature" %}
    {% endif %}

    <p class="meta | cluster" style="--gutter: var(--space-xs-s)">
      <!-- date -->
      {% set definedDate = date %} {% include "partials/date.njk" %}
      {%
        if tags.length >
        1
      %}
        <!-- tags -->
        {% for tag in tags %}{% if tag != "posts" %}
          <a class="button post-tag" href="/tags/{{ tag }}"> {{ tag }} </a>
        {% endif %}{% endfor %}
      {% endif %}
    </p>

    {% set toc = content | toc %}
    {% if toc %}
      <div class="post-body-layout">
        <aside class="post-toc">
          <p class="post-toc-title" aria-hidden="true">On this page</p>
          {{ toc | safe }}
        </aside>
        <div class="flow post-content">{{ content | safe }}</div>
      </div>
    {% else %}
      {{ content | safe }}
    {% endif %}
    {% include 'partials/edit-on.njk' %}
  </div>

  <!--  h-card infos: https://indieweb.org/authorship -->
  <div hidden class="h-entry">
    <a class="u-url" href="{{ page.url | url | absoluteUrl(meta.baseUrl) }}">{{ title }}</a>
    <a class="p-name u-url" rel="author" href="{{ meta.baseUrl }}">{{ meta.author.name }}</a>
    <!-- eleventy:ignore keeps this out of the image transform: it is hidden
         microformats markup, and an absolute src would otherwise be fetched
         over the network from the live site on every build. -->
    <img
      eleventy:ignore
      class="u-author h-card"
      src="{{ meta.author.avatar | url | absoluteUrl(meta.baseUrl) }}"
      alt="{{ meta.author.name }}"
    />
  </div>
</article>

{%- css "inline" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
{%- endcss -%}

{%- js "defer" -%}
  {%- include 'scripts/copy-code.js' -%}
  {%- include 'scripts/toc-scrollspy.js' -%}
{%- endjs -%}
